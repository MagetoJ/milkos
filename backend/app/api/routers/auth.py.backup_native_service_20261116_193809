class ApplicationStatusQuery(BaseModel):
    reference: str = Field(..., min_length=8, max_length=64)
    email: str = Field(..., min_length=3, max_length=255)


@router.post("/application-status")
def application_status(body: ApplicationStatusQuery, request: Request, db: Session = Depends(get_db)):
    """An applicant checks their cooperative application with the reference they were given AND the email they
    applied with. A wrong pair gets the same 'not found' as a missing one; only the status is returned."""
    ratelimit.hit(request, "application-status", limit=20, window_seconds=600)
    return onboarding.application_status(db, body.reference, body.email)


# ---------------- SMS delivery reports (provider -> MilkOS) ----------------

@router.post("/sms/delivery-report", include_in_schema=False)
async def sms_delivery_report(request: Request, db: Session = Depends(get_db)):
    """Africa's Talking delivery-report callback (form fields id, status, failureReason), protected by the shared
    SMS_DELIVERY_REPORT_TOKEN (?token=...). Answers 404 while that variable isn't set."""
    expected = os.getenv("SMS_DELIVERY_REPORT_TOKEN", "")
    supplied = request.query_params.get("token", "")
    if not expected or not constant_time_equals(supplied, expected):
        raise NotFound("Page", "Not found")
    # Parsed by hand: a urlencoded body needs no extra dependency.
    form = {k: v[0] for k, v in parse_qs((await request.body()).decode("utf-8", "replace")).items()}
    message_id = str(form.get("id") or "")
    if not message_id:
        raise ValidationFailed("id is required")
    state = str(form.get("status") or "")
    notifications.record_delivery_report(db, message_id, state == "Success", str(form.get("failureReason") or state) or None)
    return {"ok": True}




# ---------------------------------------------------------------------------
# Native Android Google OAuth (Authorization Code + PKCE)
# ---------------------------------------------------------------------------

NATIVE_GOOGLE_CALLBACK = "com.milkos.app://auth/google/callback"
NATIVE_OAUTH_TTL_SECONDS = 600
NATIVE_TICKET_TTL_SECONDS = 120


class NativeGoogleTicketRequest(BaseModel):
    ticket: str = Field(min_length=20, max_length=256)


def _native_google_redirect(**params: str) -> RedirectResponse:
    from urllib.parse import urlencode

    query = urlencode(params)
    return RedirectResponse(
        url=f"{NATIVE_GOOGLE_CALLBACK}?{query}" if query else NATIVE_GOOGLE_CALLBACK,
        status_code=status.HTTP_302_FOUND,
    )


@router.post("/google/native/start")
def google_native_start(
    request: Request,
    db: Session = Depends(get_db),
):
    """Create a short-lived PKCE transaction and return Google's consent URL."""
    ratelimit.hit(request, "native-google-start", 10, 60)

    try:
        state = google_oauth.generate_state()
        verifier, challenge = google_oauth.generate_pkce_pair()

        now = datetime.utcnow()
        transaction = NativeOAuthTransaction(
            state_hash=hash_token(state),
            pkce_verifier_encrypted=mfa_service.encrypt(verifier),
            expires_at=now + timedelta(seconds=NATIVE_OAUTH_TTL_SECONDS),
        )
        db.add(transaction)
        db.commit()

        authorization_url = google_oauth.native_consent_url(
            state=state,
            code_challenge=challenge,
        )
        return {"authorization_url": authorization_url}

    except google_oauth.GoogleAuthError as exc:
        db.rollback()
        raise InvalidRequest(str(exc))
    except Exception:
        db.rollback()
        raise


@router.get("/google/native/callback")
async def google_native_callback(
    request: Request,
    code: str | None = None,
    state: str | None = None,
    error: str | None = None,
    db: Session = Depends(get_db),
):
    """Validate Google's response, then issue a one-time app exchange ticket."""
    ratelimit.hit(request, "native-google-callback", 20, 60)

    if error or not code or not state:
        return _native_google_redirect(error="google_signin_cancelled")

    state_hash = hash_token(state)
    now = datetime.utcnow()

    # Consume the state atomically. A second callback using the same state
    # cannot pass this conditional update.
    consumed = db.execute(
        update(NativeOAuthTransaction)
        .where(
            NativeOAuthTransaction.state_hash == state_hash,
            NativeOAuthTransaction.state_used_at.is_(None),
            NativeOAuthTransaction.expires_at > now,
        )
        .values(state_used_at=now)
    )

    if consumed.rowcount != 1:
        db.rollback()
        return _native_google_redirect(error="invalid_or_expired_state")

    # Commit state consumption before contacting Google. Even a failed code
    # exchange must not make this state reusable.
    db.commit()

    transaction = (
        db.query(NativeOAuthTransaction)
        .filter(NativeOAuthTransaction.state_hash == state_hash)
        .first()
    )
    if transaction is None:
        return _native_google_redirect(error="oauth_transaction_not_found")

    try:
        verifier = mfa_service.decrypt(transaction.pkce_verifier_encrypted)
        email = await google_oauth.email_for_native_code(
            code=code,
            code_verifier=verifier,
        )
        sign_in = authentication.google_login(db, email)

    except google_oauth.GoogleAuthError:
        db.rollback()
        return _native_google_redirect(error="google_signin_failed")
    except Exception:
        db.rollback()
        return _native_google_redirect(error="google_signin_failed")

    # Google identity alone does not satisfy MFA. Preserve the existing
    # password + MFA process; never issue a native ticket for this account.
    if sign_in.token is None:
        return _native_google_redirect(mfa_required="1")

    # The ticket is random, short-lived, single-use, and only its hash is stored.
    ticket = generate_token()
    now = datetime.utcnow()

    db.execute(
        update(NativeOAuthTransaction)
        .where(NativeOAuthTransaction.id == transaction.id)
        .values(
            ticket_hash=hash_token(ticket),
            user_id=sign_in.user.id,
            expires_at=now + timedelta(seconds=NATIVE_TICKET_TTL_SECONDS),
        )
    )
    db.commit()

    return _native_google_redirect(ticket=ticket)


@router.post("/google/native/exchange")
def google_native_exchange(
    payload: NativeGoogleTicketRequest,
    request: Request,
    db: Session = Depends(get_db),
):
    """Exchange a one-time native ticket for the normal MilkOS access token."""
    ratelimit.hit(request, "native-google-exchange", 20, 60)

    now = datetime.utcnow()
    ticket_hash = hash_token(payload.ticket)

    # Atomic consumption prevents replay, including concurrent requests.
    consumed = db.execute(
        update(NativeOAuthTransaction)
        .where(
            NativeOAuthTransaction.ticket_hash == ticket_hash,
            NativeOAuthTransaction.ticket_used_at.is_(None),
            NativeOAuthTransaction.expires_at > now,
            NativeOAuthTransaction.user_id.is_not(None),
        )
        .values(ticket_used_at=now)
    )

    if consumed.rowcount != 1:
        db.rollback()
        raise InvalidRequest("This sign-in ticket is invalid, expired, or already used.")

    transaction = (
        db.query(NativeOAuthTransaction)
        .filter(NativeOAuthTransaction.ticket_hash == ticket_hash)
        .first()
    )
    if transaction is None or transaction.user_id is None:
        db.rollback()
        raise InvalidRequest("This sign-in ticket is invalid.")

    user = db.get(User, transaction.user_id)
    if user is None:
        db.rollback()
        raise InvalidRequest("The account could not be found.")

    # Commit ticket consumption before returning credentials.
    db.commit()

    return {
        "access_token": access_token_for(user),
        "token_type": "bearer",
        "role": user.role_value,
        "user_id": str(user.id),
        "must_change_password": bool(user.must_change_password),
    }


@router.get("/google/login")
def google_login():
    """Redirects user to Google OAuth consent screen."""
    return RedirectResponse(url=google_oauth.consent_url())


@router.get("/google/callback")
async def google_callback(code: str, db: Session = Depends(get_db)):
    """Handles Google OAuth callback, verifies user, and sets JWT session cookie."""
    try:
        email = await google_oauth.email_for_code(code)
    except google_oauth.GoogleAuthError as exc:
        raise InvalidRequest(str(exc))
    sign_in = authentication.google_login(db, email)
    if sign_in.token is None:
        # Google proves the email address, not the second factor: finish with password + code instead.
        return RedirectResponse(url=f"{google_oauth.APP_URL}/login?mfa_required=1")
    redirect = RedirectResponse(url=f"{google_oauth.APP_URL}/login?google_success=1")
    set_session_cookie(redirect, sign_in.token)
    return redirect