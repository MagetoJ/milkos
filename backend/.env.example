APP_NAME=Milkos API
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://milk:milk@localhost:5432/milk_platform

KEYCLOAK_ISSUER=http://localhost:8080/realms/milk
KEYCLOAK_AUDIENCE=milk-api
KEYCLOAK_CLIENT_ID=milk-web

CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
JWKS_CACHE_SECONDS=300

PLATFORM_ADMIN_ROLE=PLATFORM_SUPER_ADMIN
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
OTP_SECRET=change-me-to-a-random-value-of-at-least-32-chars
# Development only: return OTP codes in API responses. Never enable in production.
EXPOSE_DEV_OTP=false
