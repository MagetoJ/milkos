# backend/.env: loaded by compose (env_file) and never copied into the image.
# Copy to backend/.env and fill in. DATABASE_URL is set by compose and doesn't belong here.

# REQUIRED. The API refuses to start without it.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# REQUIRED the first time: creates the platform superadmin. Existing accounts are never changed.
SUPERADMIN_EMAIL=superadmin@milkflow.com
SUPERADMIN_PASSWORD=

# Public URL of the web app (Google login returns the browser here), and the origins allowed by CORS.
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional Google sign-in. Register this redirect URI in Google Cloud Console:
#   http://localhost:3000/api/v1/auth/google/callback   (i.e. APP_URL + /api/v1/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------- Offline sync ----------------
# Days an offline device session stays valid without reconnecting (1-30). Renewed on every online sync.
OFFLINE_SESSION_DAYS=7
# History copied to devices: milk collections / cooler readings / notifications from the last N days.
SYNC_COLLECTION_DAYS=30
SYNC_READING_DAYS=7
SYNC_NOTIFICATION_DAYS=30
# Pull cursors stay behind changes younger than this, so a slow transaction is never skipped.
SYNC_SETTLE_SECONDS=10
# Accept readings from the development sensor simulator (stored as SIMULATED, never alert by SMS).
SENSOR_ACCEPT_SIMULATED=true
# Accept collections weighed with the development scale simulator (stored as weight_source SIMULATED).
# Set to false in production so only real scale readings or labelled MANUAL weights are accepted.
SCALE_ACCEPT_SIMULATED=true

# ---------------- Collections, receipts & payments ----------------
# SMS receipt to each farmer for every confirmed collection (cooperatives can also switch it off).
# Each receipt costs one SMS credit and is reported SENT only when the SMS provider accepts it.
RECEIPT_SMS_ENABLED=true
# Farmer payout provider. Empty = none: payments are marked PAID only by recording the transaction
# reference of a transfer made outside MilkOS. No provider is implemented yet (see services/payouts).
PAYOUT_PROVIDER=

# ---------------- Cooler alerts & SMS ----------------
ALERT_COOLDOWN_MINUTES=60
# Times in alert messages are shown at UTC+3 (Kenya).
ALERT_UTC_OFFSET_HOURS=3
# SMS provider: empty (none - alerts are stored and marked FAILED "not configured"), africastalking or webhook.
SMS_PROVIDER=
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
AFRICASTALKING_SANDBOX=false
# For SMS_PROVIDER=webhook: POST {"to", "message"} as JSON (2xx = accepted).
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# ---------------- account security ----------------
# APP_URL (above) is also the base of the SMS activation and password-reset links (<APP_URL>/activate-account#t=...).
# Send the session cookie over HTTPS only. Set to true in every deployment served over HTTPS.
COOKIE_SECURE=false
# Key that encrypts two-step-verification (TOTP) secrets at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# When unset, a key is derived from SECRET_KEY (rotating SECRET_KEY then disables existing enrolments).
MFA_ENCRYPTION_KEY=
# Shared secret for SMS delivery reports. Configure the provider's delivery-report URL as
#   <public API URL>/api/v1/auth/sms/delivery-report?token=<this value>
# Unset = delivery reports are refused and SMS show "Sent" (accepted by the provider), never "Delivered".
SMS_DELIVERY_REPORT_TOKEN=
# Test suites only: lower bcrypt cost. Never set in production.
# BCRYPT_ROUNDS=4
