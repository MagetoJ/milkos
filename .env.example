# Root .env: read automatically by `docker compose` (used as frontend build args).
# Copy to .env and fill in. Changing a NEXT_PUBLIC_* value needs `docker compose build frontend`.

# Optional: password for the compose Postgres container (defaults to a dev-only value).
# Set it BEFORE the first `docker compose up`; the database keeps the first password it was created with.
# POSTGRES_PASSWORD=

# Offer the development scale simulator in production builds (always offered in development builds).
# Weights from it are recorded as SIMULATED; set SCALE_ACCEPT_SIMULATED=false in backend/.env to refuse them.
# NEXT_PUBLIC_SCALE_SIMULATOR=1
