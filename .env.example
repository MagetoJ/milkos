NODE_ENV=development
API_PORT=4000
WEB_URL=http://localhost:3000
DATABASE_URL=postgresql://milk:milk@localhost:5432/milk_platform
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info

# Supabase Auth (see docs/AUTH.md). Local CLI stack: http://127.0.0.1:54321
SUPABASE_URL=https://your-project-ref.supabase.co
# Server only. Needed for inviting users and suspending accounts. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Only for projects still signing tokens with the legacy shared HS256 secret; leave empty for JWKS signing keys.
SUPABASE_JWT_SECRET=
# Managers, accountants and platform staff must verify with an authenticator app. Set false only for local development.
AUTH_REQUIRE_MFA=true

# Web app (baked into the Next.js build)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

SMS_PROVIDER=dummy
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
EMAIL_FROM=no-reply@example.com
