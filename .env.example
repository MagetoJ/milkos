NODE_ENV=development
API_PORT=4000
WEB_URL=http://localhost:3000
LOG_LEVEL=info

# --- Database (Supabase Postgres) ---
# Hosted Supabase: DATABASE_URL = transaction pooler (port 6543) with ?pgbouncer=true&connection_limit=1,
# DIRECT_URL = session/direct connection (port 5432) used by `prisma migrate`.
# Local Supabase CLI (`supabase start`): both = postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
REDIS_URL=redis://localhost:6379

# --- Supabase Auth (API: apps/api/.env) ---
# Hosted: https://<project-ref>.supabase.co   Local CLI: http://127.0.0.1:54321
SUPABASE_URL=http://127.0.0.1:54321
# Leave empty on projects using asymmetric JWT signing keys (default for new projects).
SUPABASE_JWT_SECRET=
# SERVER ONLY — never expose to the browser. Required for user invitations.
SUPABASE_SERVICE_ROLE_KEY=
# Platform staff, managers and accountants must use TOTP MFA. Only set false for local debugging.
AUTH_REQUIRE_MFA=true

# --- Web (apps/web/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key (sb_publishable_...) or legacy anon key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Phone OTP needs the Supabase Send SMS hook wired to Africa's Talking first.
NEXT_PUBLIC_AUTH_PHONE_ENABLED=false

# --- Supabase CLI (supabase/config.toml) ---
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Notifications ---
SMS_PROVIDER=dummy
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
EMAIL_FROM=no-reply@example.com
