+/** Sign out: the backend must delete the HttpOnly cookie, since JS can't. */
+export async function logout() {
+  clearLegacyToken();
+  try {
+    await fetch('/api/v1/auth/logout', { method: 'POST', credentials: 'same-origin' });
+  } finally {
+    window.location.assign(LOGIN_PATH);
+  }
+}