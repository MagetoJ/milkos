diff --git a/backend/.env.example b/backend/.env.example
new file mode 100644
index 0000000..14ddbe5
--- /dev/null
+++ b/backend/.env.example
@@ -0,0 +1,19 @@
+# backend/.env: loaded by compose (env_file) and never copied into the image.
+# Copy to backend/.env and fill in. DATABASE_URL is set by compose and doesn't belong here.
+
+# REQUIRED. The API refuses to start without it.
+# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
+SECRET_KEY=
+
+# REQUIRED the first time: creates the platform superadmin. Existing accounts are never changed.
+SUPERADMIN_EMAIL=superadmin@milkflow.com
+SUPERADMIN_PASSWORD=
+
+# Public URL of the web app (Google login returns the browser here), and the origins allowed by CORS.
+APP_URL=http://localhost:3000
+CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
+
+# Optional Google sign-in. Register this redirect URI in Google Cloud Console:
+#   http://localhost:3000/api/v1/auth/google/callback   (i.e. APP_URL + /api/v1/auth/google/callback)
+GOOGLE_CLIENT_ID=
+GOOGLE_CLIENT_SECRET=
diff --git a/backend/Dockerfile b/backend/Dockerfile
index 3b699ce..d644234 100644
--- a/backend/Dockerfile
+++ b/backend/Dockerfile
@@ -2,17 +2,26 @@ FROM python:3.12-slim
 
 WORKDIR /app
 
-ENV PYTHONDONTWRITEBYTECODE=1
-ENV PYTHONUNBUFFERED=1
+ENV PYTHONDONTWRITEBYTECODE=1 \
+    PYTHONUNBUFFERED=1 \
+    PIP_DISABLE_PIP_VERSION_CHECK=1
 
 COPY requirements.txt .
 
-RUN pip install --no-cache-dir --upgrade pip \
-    && pip install --no-cache-dir -r requirements.txt
+# The pip cache mount keeps downloaded wheels between builds, so a requirements change
+# (or a retry after a network failure) doesn't re-download everything.
+RUN --mount=type=cache,target=/root/.cache/pip \
+    pip install --root-user-action=ignore -r requirements.txt
 
 COPY . .
 
+# Run as an unprivileged user
+RUN useradd --system --uid 10001 --no-create-home app && chown -R app:app /app
+USER app
+
 EXPOSE 8000
 
-# Bring the schema to head and make sure the superadmin exists (both idempotent), then serve
+# Bring the schema to head and make sure the superadmin exists (both idempotent), then serve.
+# `&&` means a failed migration or a missing SUPERADMIN_PASSWORD stops the container
+# instead of starting an API that can't work.
 CMD ["sh", "-c", "alembic upgrade head && python seed_superadmin.py && exec uvicorn main:app --host 0.0.0.0 --port 8000"]
